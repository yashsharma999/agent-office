# ---- Which model to use --------------------------------------------------
# Easiest switch: pick a preset (see src/model.js)
#   local = Ollama on your machine (free, offline)
#   dev   = Bedrock Sonnet 4.6     (uses AWS credits)
#   demo  = Anthropic Opus 5       (uses ANTHROPIC_API_KEY)
MODEL_PRESET=dev

# Or set these manually instead of MODEL_PRESET:
# MODEL_PROVIDER=bedrock            # bedrock | anthropic | ollama
# BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
# ANTHROPIC_MODEL_ID=claude-opus-5
# MAX_TOKENS=4096

# ---- AWS Bedrock credentials (pick ONE style) ----------------------------
AWS_REGION=us-east-1
# Style A: Bedrock API key
AWS_BEARER_TOKEN_BEDROCK=
# Style B: IAM access keys
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- Anthropic API -------------------------------------------------------
ANTHROPIC_API_KEY=

# ---- Ollama (local, no key needed) ---------------------------------------
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL_ID=llama3.1

# ---- deployed AgentCore runtime (used by `npm run ui:cloud`) --------------
AGENT_TARGET=local
AGENT_RUNTIME_ARN=

# ---- where finished documents and browser frames are stored ---------------
# Leave blank to fall back to inline data: URLs (fine for local use).
ARTIFACT_BUCKET=
