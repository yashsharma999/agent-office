# App Runner runs x86_64 container images (unlike AgentCore, which needs arm64).
FROM --platform=linux/amd64 public.ecr.aws/docker/library/node:22-slim

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY src ./src
COPY public ./public
COPY ui-server.js ./

ENV NODE_ENV=production
ENV PORT=8080
# Talk to the deployed AgentCore runtime rather than running an agent in here.
ENV AGENT_TARGET=agentcore

EXPOSE 8080

CMD ["node", "ui-server.js"]
